// ============================================================
//
// Fork read passive script
//
// ============================================================
// in: 
// List<DataInputPort> inputs,
// List<DataOutputPort> outputs,
// long outputIdx,
// long outputInstanceIdx,
// List<String, int> parameters,
// out:
// long rbeginji
// long rendji

long rbeginj = 0L;
for(int j = 0; j < outputIdx; j ++) {
	long ratePort = outputs.get(j).getExpression().evaluateAsLong();
	rbeginj += ratePort;	
}

long rateOpposite = outputs.get(outputIdx).getOppositePort().getExpression().evaluateAsLong();
rbeginji = rbeginj + rateOpposite * outputInstanceIdx;
rendji = rbeginji + rateOpposite;
