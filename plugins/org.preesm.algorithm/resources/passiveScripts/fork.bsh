// ============================================================
//
// Fork read passive script
//
// ============================================================
// in: 
// List<DataInputPort> inputs,
// List<DataOutputPort> outputs,
// int outputIdx,
// int outputInstanceIdx,
// List<String, int> parameters,
// out:
// rbeginji
// rendji

int rbeginj = 0;
for(int j = 0; j < outputIdx - 1; j ++) {
	int rateOppositePort = outputs.get(j).getOppositePort().getExpression().evaluateAsLong();
	int ratePort = outputs.get(j).getExpression().evaluateAsLong();
	int repOppositeActor = ratePort / rateOppositePort;
	rbeginj += rateOppositePort * repOppositeActor;	
}

int ratej = outputs.get(outputIdx).getOppositePort().getExpression().evaluateAsLong();
rbeginji = rbeginj + ratej * outputInstanceIdx;
rendji = rbeginji + ratej;

