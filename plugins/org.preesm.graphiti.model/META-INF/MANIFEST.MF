Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: %pluginName
Automatic-Module-Name: org.preesm.graphiti.model
Bundle-SymbolicName: org.preesm.graphiti.model;singleton:=true
Bundle-Version: 3.21.0.qualifier
Require-Bundle: org.preesm.commons;bundle-version="3.21.0",
 javax.annotation;bundle-version="1.2.0",
 org.eclipse.core.runtime,
 org.eclipse.core.resources,
 org.eclipse.draw2d,
 org.eclipse.ui,
 org.eclipse.ui.ide,
 wrapped.net.sf.saxon.Saxon-HE,
 org.jgrapht.core;bundle-version="1.1.0"
Bundle-RequiredExecutionEnvironment: JavaSE-17
Export-Package: org.preesm.graphiti,
 org.preesm.graphiti.io,
 org.preesm.graphiti.model,
 org.preesm.graphiti.validators
Bundle-ActivationPolicy: lazy
Bundle-ClassPath: .
Bundle-Vendor: %providerName
Bundle-Localization: plugin
Bundle-Activator: org.preesm.graphiti.GraphitiModelPlugin
