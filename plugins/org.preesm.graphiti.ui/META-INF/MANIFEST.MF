Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: %pluginName
Automatic-Module-Name: org.preesm.graphiti.ui
Bundle-SymbolicName: org.preesm.graphiti.ui;singleton:=true
Bundle-Version: 3.21.0.qualifier
Bundle-Activator: org.preesm.graphiti.ui.GraphitiUiPlugin
Require-Bundle: org.eclipse.core.resources,
 org.eclipse.core.runtime,
 org.eclipse.gef,
 org.eclipse.ui.ide,
 org.eclipse.ui.views.properties.tabbed,
 org.preesm.graphiti.model;visibility:=reexport
Bundle-RequiredExecutionEnvironment: JavaSE-21
Export-Package: org.preesm.graphiti.ui,
 org.preesm.graphiti.ui.actions,
 org.preesm.graphiti.ui.commands,
 org.preesm.graphiti.ui.commands.copypaste,
 org.preesm.graphiti.ui.commands.refinement,
 org.preesm.graphiti.ui.editors,
 org.preesm.graphiti.ui.editparts,
 org.preesm.graphiti.ui.editpolicies,
 org.preesm.graphiti.ui.figure,
 org.preesm.graphiti.ui.figure.shapes,
 org.preesm.graphiti.ui.properties,
 org.preesm.graphiti.ui.wizards
Bundle-ActivationPolicy: lazy
Bundle-ClassPath: .
Bundle-Vendor: %providerName
Bundle-Localization: plugin
