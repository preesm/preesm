ROOT_DIR=$(realpath $(dir $(lastword $(MAKEFILE_LIST))))
PLATFORM_NAME=kr260_custom
PLATFORM_NAME_FSBL=kr260_custom_fsbl

XSA_NAME=kr260_hardware_platform
VERSION=2024.1
COMMON_IMAGE ?=../../xilinx-zynqmp-common-v$(VERSION)/
DT_PLAT_NAME=mydevice
DT_PATH=$(ROOT_DIR)/$(DT_PLAT_NAME)/psu_cortexa53_0/device_tree_domain/bsp
DTB =$(ROOT_DIR)/$(DT_PLAT_NAME)/psu_cortexa53_0/device_tree_domain/bsp/system.dtb

SYSROOT=sysroot

DEVICE_TREE_REPO ?=

#ifndef DEVICE_TREE_REPO
DEVICE_TREE_REPO=https://github.com/Xilinx/device-tree-xlnx.git
#endif


.PHONY: help 

help:
	@echo "Makefile usage"
	@echo "make all COMMON_IMAGE=<path/to/common_image/>  	## Generate platform with pre-built software components"
	

all: check-common-image dtb dtbo pfm #sysroot

#target : check  whether the common image is ready 
check-common-image: remove_previous_builds
ifeq ($(wildcard $(COMMON_IMAGE)),)
	@echo "'COMMON_IMAGE' is not accessible, please download common image from Xilinx Downloads website and set this flag to specify the common image path."
	@echo "Path tried :" $(COMMON_IMAGE)
	@make help
	@echo "exit ....." && exit 1
endif



dtb: 
	@echo "execute createdts to generate dtb file"
	xsct -eval " createdts -hw ../vivado_soc/build/vivado/$(XSA_NAME).xsa -zocl  -platform-name $(DT_PLAT_NAME) -out .  -git-branch xlnx_rel_v2024.1  -overlay -compile"

dtbo:$(DT_PATH)/pl.dtsi
	dtc -@ -O dtb -o $(DT_PATH)/pl.dtbo $(DT_PATH)/pl.dtsi
	mkdir -p dtbo_output && cp $(DT_PATH)/pl.dtbo dtbo_output/


#create platfrom 
pfm:
	@echo "INFO: Creating  Platform $(PLATFORM_NAME)"
	mkdir -p tmp && export XILINX_VITIS_DATA_DIR="./tmp" && vitis -s platform_creation.py --platform_name $(PLATFORM_NAME) --xsa_path ../vivado_soc/build/vivado/$(XSA_NAME).xsa --boot $(COMMON_IMAGE) --dtb $(DTB)
	@echo "INFO: Checking created platforms:" && find . -name "*.xpfm"



#install SDK tool
sysroot: $(SYSROOT)

$(SYSROOT): $(COMMON_IMAGE)/sdk.sh
	mkdir -p $(COMMON_IMAGE)/$(SYSROOT) && sh $(COMMON_IMAGE)/sdk.sh -d $(COMMON_IMAGE)/ -y

# keep only the makefile and .tcl files
remove_previous_builds:
	rm -rf $(shell find . -mindepth 1 -maxdepth 2 ! -name 'Makefile' ! -name 'platform_creation.py')

clean:
	$(RM) -r IDE.log $(PLATFORM_NAME) $(PLATFORM_NAME_FSBL) device-tree-xlnx  mydevice dt_output dtg dtbo_output

ultraclean: clean
	$(RM) -r   sysroot