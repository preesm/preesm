ROOT_DIR=$(realpath $(dir $(lastword $(MAKEFILE_LIST))))
ABS_BUILD_PATH=$(ROOT_DIR)/build
ABS_HW_PATH=$(ABS_BUILD_PATH)/vivado
BD_TCL=system_step1.tcl
ABS_BD_TCL=$(ROOT_DIR)/$(BD_TCL)
XSA_NAME?=kr260_hardware_platform.xsa

.PHONY: help

help:
	@echo "Makefile usage"
	@echo "make all 	## Generate hw platform and export XSA file"

all: hw

hw: remove_previous_builds
	mkdir -p $(ABS_HW_PATH)
	cd $(ABS_HW_PATH); vivado -mode batch -notrace -source $(ABS_BD_TCL) -source $(ROOT_DIR)/export_xsa.tcl
	mv $(ABS_HW_PATH)/kr260_hardware_platform.xsa $(ABS_HW_PATH)/${XSA_NAME}

# keep only the makefile and .tcl files
remove_previous_builds:
	rm -rf $(shell find . -mindepth 1 -maxdepth 2 ! -name 'Makefile' ! -name 'export_xsa.tcl' ! -name 'system_step1.tcl')


clean:
	$(RM) -r $(ABS_BUILD_PATH) vivado*.log vivado*.jou 
