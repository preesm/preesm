ROOT_DIR=$(realpath $(dir $(lastword $(MAKEFILE_LIST))))
TARGET?=ultrascale
PLATFORM_NAME=$(TARGET)_custom
PLATFORM=$(ROOT_DIR)/../vitis_platform/$(PLATFORM_NAME)/export/$(PLATFORM_NAME)/$(PLATFORM_NAME).xpfm
SW_COMP=$(ROOT_DIR)/../vitis_platform/sw_comp/
VERSION?=2024.1
VITIS_DIR?=/tools/Xilinx/$(VERSION)/Vitis
COMMON_IMAGE ?=${ROOT_DIR}/../xilinx-zynqmp-common-v$(VERSION)
SYSROOT := $(COMMON_IMAGE)/sysroots/cortexa72-cortexa53-xilinx-linux

.PHONY: help  

help:
	@echo "Makefile usage"
	@echo "make all 	## Generate and package application related files"

all: app_hw_package


shell.json:
	printf '{\n  "shell_type" : "XRT_FLAT",\n  "num_slots": "1"\n}' > shell.json

app_hw_package: remove_previous_builds write_version display_variables shell.json
	vitis -s builder.py "hls_component" "system_project"  $(COMMON_IMAGE) $(TARGET) $(VERSION) $(VITIS_DIR)
	@echo "INFO: Packaging Completed"

write_version:
	mkdir _ide/
	@echo "com.ide.version=${VERSION}" >> _ide/version.ini

display_variables:
	@echo $('\n') "Variable values : "
	@echo $('\t')"TARGET = $(TARGET)"
	@echo $('\t')"VERSION = $(VERSION)"
	@echo $('\t')"VITIS_DIR = $(VITIS_DIR)"
	@echo $('\t')"COMMON_IMAGE = $(COMMON_IMAGE)"
	@echo $('\n')

# keep only the makefile, builder.py and shell.json
remove_previous_builds:
	rm -rf $(shell find . -mindepth 1 -maxdepth 2 ! -name 'builder.py' ! -name 'Makefile' ! -name 'shell.json')

clean:
	-$(MAKE) -C $(VADD_WORK) clean
	-$(MAKE) -C platforminfo/ clean
	rm -rf vadd/

ultraclean:clean
	rm -rf $(VADD_WORK)

help:
	@echo "Usage : make all <TARGET> <VERSION> <VITIS_DIR> <COMMON_IMAGE>"
	@echo "TARGET : target name, defaults to ultrascale"
	@echo "VERSION : vitis version, defaults to 2024.1"
	@echo "VITIS_DIR : vitis directory location, defaults to /tools/Xilinx/$(VERSION)/Vitis"
	@echo "COMMON_IMAGE : common image location, defaults to ${ROOT_DIR}/../xilinx-zynqmp-common-v$(VERSION)"