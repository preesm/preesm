VERSION?=2024.1
COMMON_IMAGE?=../xilinx-zynqmp-common-v$(VERSION)/
TARGET?=ultrascale

.PHONY: help

help:
	@echo "Makefile usage"
	@echo "make all COMMON_IMAGE=<path/to/common_image/> 	## Generate platform with pre-built software components and compile the vadd application to test this platform "


all: check-common-image step1 step2 step3 

#target : check  whether the common image is ready 
check-common-image:
ifeq ($(wildcard $(COMMON_IMAGE)/Image),)
	@echo "'COMMON_IMAGE' is not accessible, please download common image from Xilinx Downloads website and set this flag to specify the common image path."
	@make help
	@echo "exit ....." && exit 1
endif
	
all: step1 step2 step3 

step1:
	$(MAKE) -C vivado_soc all VERSION=${VERSION}

step2:
	$(MAKE) -C vitis_platform all VERSION=${VERSION}

step3:
	$(MAKE) -C system_project all VERSION=${VERSION}
	spd-say "vitis process over"


clean:
	$(MAKE) -C step1 clean
	$(MAKE) -C step2 clean
	$(MAKE) -C step3 clean
ultraclean:clean
	$(MAKE) -C step2 ultraclean
	$(MAKE) -C step3 ultraclean