Content-Type: text/ecl
Entry-Name: .content

with [get-view "Project Explorer" | get-tree] {
    select "org.ietr.preesm.sobel" | double-click
    select "org.ietr.preesm.sobel/Workflows" | double-click
    select "org.ietr.preesm.sobel/Workflows/Codegen.workflow" | get-menu -path "Preesm/Run Workflow" | click
}
with [get-window "Select an existing scenario file."] {
    get-tree | select "org.ietr.preesm.sobel/Scenarios/01-display_1core.scenario"
    get-button OK | click
}
get-view "Project Explorer" | get-tree | select "org.ietr.preesm.sobel/Workflows/Codegen.workflow" | double-click

with [get-editor "Codegen.workflow" | get-diagram -index 1] {
    mouse-move 414 120 button3 -height 387 -width 664
    mouse-press 414 120 button3 -height 387 -width 664
    mouse-release 414 120 button3 -height 387 -width 664
    get-menu -path "Run Workflow" | click
}
with [get-editor "Codegen.workflow" | get-diagram -index 1] {
    mouse-move 405 99 button3 -height 387 -width 664
    mouse-press 334 94 button3 -height 387 -width 664
    get-menu -path "Run Workflow" | click -metaKeys ""
}
with [get-window "Select an existing scenario file."] {
    get-tree | select "org.ietr.preesm.sobel/Scenarios/01-display_1core.scenario"
    get-button OK | click -metaKeys ""
}
