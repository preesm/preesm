        </constraintGroup>
    </constraints>
    <timings excelUrl="">
        <memcpyspeed opname="x86_f1" setuptime="1" timeperunit="0.001"/>
    </timings>
    <simuParams>
        <mainCore>Core0</mainCore>
        <mainComNode>shared_mem</mainComNode>
