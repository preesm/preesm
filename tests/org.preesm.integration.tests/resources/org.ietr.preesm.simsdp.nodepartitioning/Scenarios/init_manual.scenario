        <architecture url="/org.ietr.preesm.simsdp.nodepartitioning/Archi/1CoresX86.slam"/>
        <codegenDirectory url="/org.ietr.preesm.simsdp.nodepartitioning/Code/generated"/>
    </files>
    <constraints excelUrl="">
        <constraintGroup>
            <operator name="Core0"/>
            <task name="top/sub0/Data_Acquisition"/>
            <task name="top/sub0/Plot_RnI_Histo"/>
            <task name="top/sub0/MAD_Computation"/>
            <task name="top/sub0/STD_Computation"/>
