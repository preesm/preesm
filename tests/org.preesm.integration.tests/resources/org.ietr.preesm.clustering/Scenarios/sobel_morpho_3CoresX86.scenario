<?xml version="1.0" encoding="UTF-8"?>
<scenario>
    <flags>
        <sizesAreInBit/>
    </flags>
    <files>
        <algorithm url="/org.ietr.preesm.clustering/Algo/sobel_morpho.pi"/>
        <architecture url="/org.ietr.preesm.clustering/Archi/3CoresX86.slam"/>
        <codegenDirectory url="/org.ietr.preesm.clustering/Code/generated/"/>
    </files>
    <constraints excelUrl="">
        <constraintGroup>
            <operator name="Core0"/>
            <task name="sobel_morpho/Read_YUV"/>
            <task name="sobel_morpho/display"/>
            <task name="sobel_morpho/Sobel"/>
            <task name="sobel_morpho/Split"/>
            <task name="sobel_morpho/Dilation"/>
            <task name="sobel_morpho/Erosion"/>
        </constraintGroup>
        <constraintGroup>
            <operator name="Core1"/>
            <task name="sobel_morpho/Read_YUV"/>
            <task name="sobel_morpho/display"/>
            <task name="sobel_morpho/Sobel"/>
            <task name="sobel_morpho/Split"/>
            <task name="sobel_morpho/Dilation"/>
            <task name="sobel_morpho/Erosion"/>
        </constraintGroup>
        <constraintGroup>
            <operator name="Core2"/>
            <task name="sobel_morpho/Read_YUV"/>
            <task name="sobel_morpho/display"/>
            <task name="sobel_morpho/Sobel"/>
            <task name="sobel_morpho/Split"/>
            <task name="sobel_morpho/Dilation"/>
            <task name="sobel_morpho/Erosion"/>
        </constraintGroup>
    </constraints>
    <timings excelUrl="">
        <timing opname="x86" time="100" timingtype="EXECUTION_TIME" vertexname="sobel_morpho/Read_YUV"/>
        <timing opname="x86" time="100" timingtype="EXECUTION_TIME" vertexname="sobel_morpho/display"/>
        <timing opname="x86" time="100" timingtype="EXECUTION_TIME" vertexname="sobel_morpho/Sobel"/>
        <timing opname="x86" time="100" timingtype="EXECUTION_TIME" vertexname="sobel_morpho/Split"/>
        <timing opname="x86" time="100" timingtype="EXECUTION_TIME" vertexname="sobel_morpho/Dilation"/>
        <timing opname="x86" time="100" timingtype="EXECUTION_TIME" vertexname="sobel_morpho/Erosion"/>
        <memcpyspeed opname="x86" setuptime="1" timeperunit="9.99000999000999E-4"/>
    </timings>
    <simuParams>
        <mainCore>Core0</mainCore>
        <mainComNode>shared_mem</mainComNode>
        <averageDataSize>1000</averageDataSize>
        <dataTypes>
            <dataType name="uchar" size="8"/>
        </dataTypes>
        <specialVertexOperators>
            <specialVertexOperator path="Core0"/>
            <specialVertexOperator path="Core1"/>
            <specialVertexOperator path="Core2"/>
        </specialVertexOperators>
    </simuParams>
    <parameterValues/>
    <papifyConfigs xmlUrl=""/>
    <energyConfigs xmlUrl="">
        <performanceObjective objectiveEPS="0.0"/>
        <peActorsEnergy/>
    </energyConfigs>
</scenario>
